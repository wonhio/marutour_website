# Copy this file to .env.local for local development and add the same
# keys in Vercel → Project Settings → Environment Variables for production.

# Used to build absolute URLs (Open Graph, sitemap). Set to the production
# domain in Vercel; defaults to marutour.com in code if not set.
NEXT_PUBLIC_SITE_URL=https://marutour.com

# Optional: wire these up if/when the contact form should send real email
# (e.g. via Resend: https://resend.com)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=partners@marutour.com
